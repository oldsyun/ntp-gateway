{
  "schema_version": 4,
  "system": {
    "listen_host": "0.0.0.0",
    "http_port": 80,
    "timezone": "Asia/Shanghai",
    "admin_user": "admin",
    "password_hash": "",
    "must_change_password": true,
    "session_ttl_sec": 28800,
    "log_max_bytes": 1048576,
    "log_backup_count": 5
  },
  "ntp": {
    "enabled": true,
    "servers": [
      "ntp.aliyun.com",
      "ntp.tencent.com",
      "time.cloudflare.com"
    ],
    "sync_interval_sec": 60,
    "timeout_ms": 1500,
    "max_age_sec": 300,
    "holdover_max_sec": 3600,
    "allow_holdover": false,
    "max_step_sec": 86400,
    "auto_compensate": true,
    "slew_threshold_sec": 0.001,
    "step_threshold_sec": 0.05
  },
  "schedule": {
    "ntp_required": true,
    "retry_count": 2,
    "retry_interval_sec": 2
  },
  "ports": [
    {
      "id": 1,
      "name": "COM1",
      "device": "/dev/ttyS1",
      "enabled": false,
      "baudrate": 9600,
      "databits": 8,
      "stopbits": 1,
      "parity": "E",
      "slave_addr": 0,
      "broadcast": true,
      "schedule_mode": "interval",
      "interval_sec": 3600,
      "daily_time": "00:00:00",
      "wait_response": false,
      "response_timeout_ms": 500,
      "full_register": 402504,
      "rs485_auto_direction": true
    },
    {
      "id": 2,
      "name": "COM2",
      "device": "/dev/ttyS2",
      "enabled": false,
      "baudrate": 9600,
      "databits": 8,
      "stopbits": 1,
      "parity": "N",
      "slave_addr": 0,
      "broadcast": true,
      "schedule_mode": "interval",
      "interval_sec": 60,
      "daily_time": "00:00:00",
      "wait_response": false,
      "response_timeout_ms": 500,
      "full_register": 402504,
      "rs485_auto_direction": true
    },
    {
      "id": 3,
      "name": "COM3",
      "device": "/dev/ttyS3",
      "enabled": false,
      "baudrate": 9600,
      "databits": 8,
      "stopbits": 1,
      "parity": "N",
      "slave_addr": 0,
      "broadcast": true,
      "schedule_mode": "interval",
      "interval_sec": 3600,
      "daily_time": "00:00:00",
      "wait_response": false,
      "response_timeout_ms": 500,
      "full_register": 402504,
      "rs485_auto_direction": true
    },
    {
      "id": 4,
      "name": "COM4",
      "device": "/dev/ttyS4",
      "enabled": false,
      "baudrate": 9600,
      "databits": 8,
      "stopbits": 1,
      "parity": "N",
      "slave_addr": 0,
      "broadcast": true,
      "schedule_mode": "interval",
      "interval_sec": 60,
      "daily_time": "00:00:00",
      "wait_response": false,
      "response_timeout_ms": 500,
      "full_register": 402504,
      "rs485_auto_direction": true
    }
  ]
}
